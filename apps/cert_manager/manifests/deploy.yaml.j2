apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ app_values.cert_manager_cluster_issuer_name }}
spec:
  acme:
    email: {{ app_values.cert_manager_acme_email }}
    server: {{ app_values.cert_manager_acme_server }}
    privateKeySecretRef:
      name: {{ app_values.cert_manager_private_key_secret_name }}
    solvers:
      - http01:
          ingress:
            class: {{ app_values.cert_manager_ingress_class }}
