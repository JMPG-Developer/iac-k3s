apiVersion: v1
kind: Namespace
metadata:
  name: {{ app_values.cloudflared_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ app_values.cloudflared_secret_name }}
  namespace: {{ app_values.cloudflared_namespace }}
type: Opaque
stringData:
  TUNNEL_TOKEN: "{{ app_values.cloudflared_tunnel_token }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflared-deployment
  namespace: {{ app_values.cloudflared_namespace }}
spec:
  replicas: {{ app_values.cloudflared_replicas }}
  selector:
    matchLabels:
      pod: cloudflared
  template:
    metadata:
      labels:
        pod: cloudflared
    spec:
{% if app_values.cloudflared_dns_enabled %}
      dnsPolicy: "None"
      dnsConfig:
        nameservers:
{% for ns in app_values.cloudflared_dns_nameservers %}
          - {{ ns }}
{% endfor %}
        searches:
          - {{ app_values.cloudflared_namespace }}.svc.cluster.local
          - svc.cluster.local
          - cluster.local
        options:
          - name: ndots
            value: "2"
          - name: edns0
            value: "true"
{% endif %}
      securityContext:
        sysctls:
          - name: net.ipv4.ping_group_range
            value: "65532 65532"
      containers:
        - image: {{ app_values.cloudflared_image }}
          name: cloudflared
          env:
            - name: TUNNEL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{ app_values.cloudflared_secret_name }}
                  key: TUNNEL_TOKEN
          command:
            - cloudflared
            - tunnel
            - --no-autoupdate
            - --loglevel
            - {{ app_values.cloudflared_loglevel }}
            - --metrics
            - 0.0.0.0:{{ app_values.cloudflared_metrics_port }}
            - run
          livenessProbe:
            httpGet:
              path: /ready
              port: {{ app_values.cloudflared_metrics_port }}
            failureThreshold: 1
            initialDelaySeconds: 10
            periodSeconds: 10
