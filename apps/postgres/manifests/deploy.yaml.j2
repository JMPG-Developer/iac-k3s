apiVersion: v1
kind: Namespace
metadata:
  name: {{ app_values.postgres_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: {{ app_values.postgres_namespace }}
  labels:
    app: postgres
type: Opaque
stringData:
  POSTGRES_DB: {{ app_values.postgres_db }}
  POSTGRES_USER: {{ app_values.postgres_user }}
  POSTGRES_PASSWORD: "{{ app_values.postgres_password }}"
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: postgres-volume
  namespace: {{ app_values.postgres_namespace }}
  labels:
    type: local
    app: postgres
spec:
  storageClassName: {{ app_values.postgres_storage_class }}
  capacity:
    storage: {{ app_values.postgres_storage }}
  accessModes:
    - ReadWriteOnce
  hostPath:
    path: {{ app_values.postgres_pv_path }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-volume-claim
  namespace: {{ app_values.postgres_namespace }}
  labels:
    app: postgres
spec:
  storageClassName: {{ app_values.postgres_storage_class }}
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ app_values.postgres_storage }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: {{ app_values.postgres_namespace }}
spec:
  replicas: {{ app_values.postgres_replicas }}
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
    spec:
      containers:
        - name: postgres
          image: "{{ app_values.postgres_image }}"
          imagePullPolicy: {{ app_values.postgres_image_pull_policy }}
          ports:
            - containerPort: {{ app_values.postgres_port }}
          envFrom:
            - secretRef:
                name: postgres-secret
          volumeMounts:
            - mountPath: /var/lib/postgresql/data
              name: postgresdata
      volumes:
        - name: postgresdata
          persistentVolumeClaim:
            claimName: postgres-volume-claim
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: {{ app_values.postgres_namespace }}
  labels:
    app: postgres
spec:
  type: ClusterIP
  ports:
    - port: {{ app_values.postgres_port }}
      targetPort: {{ app_values.postgres_port }}
  selector:
    app: postgres
