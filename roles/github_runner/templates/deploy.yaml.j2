apiVersion: v1
kind: Namespace
metadata:
  name: {{ github_runner_namespace }}
{% for runner in github_runners %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ runner.name }}-token
  namespace: {{ github_runner_namespace }}
type: Opaque
stringData:
  token: "{{ runner.token }}"
{% if runner.deploy_namespaces | default([]) | length > 0 %}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ runner.name }}-deployer
  namespace: {{ github_runner_namespace }}
{% for ns in runner.deploy_namespaces %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ns }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ runner.name }}-deployer
  namespace: {{ ns }}
rules:
  - apiGroups: ['apps']
    resources: ['deployments']
    verbs: ['get', 'list', 'watch', 'create', 'update', 'patch']
  - apiGroups: ['apps']
    resources: ['replicasets']
    verbs: ['get', 'list', 'watch']
  - apiGroups: ['']
    resources: ['services']
    verbs: ['get', 'list', 'watch', 'create', 'update', 'patch']
  - apiGroups: ['']
    resources: ['pods']
    verbs: ['get', 'list', 'watch']
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ runner.name }}-deployer
  namespace: {{ ns }}
subjects:
  - kind: ServiceAccount
    name: {{ runner.name }}-deployer
    namespace: {{ github_runner_namespace }}
roleRef:
  kind: Role
  name: {{ runner.name }}-deployer
  apiGroup: rbac.authorization.k8s.io
{% endfor %}
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ runner.name }}
  namespace: {{ github_runner_namespace }}
  labels:
    app: {{ runner.name }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ runner.name }}
  template:
    metadata:
      labels:
        app: {{ runner.name }}
    spec:
{% if runner.deploy_namespaces | default([]) | length > 0 %}
      serviceAccountName: {{ runner.name }}-deployer
{% endif %}
      containers:
        - name: runner
          image: {{ github_runner_image }}
          env:
            - name: RUNNER_NAME
              value: "{{ runner.name }}"
{% if runner.scope == 'org' %}
            - name: RUNNER_ORG
              value: "{{ runner.target }}"
{% else %}
            - name: RUNNER_REPO
              value: "{{ runner.target }}"
{% endif %}
            - name: RUNNER_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{ runner.name }}-token
                  key: token
            - name: DOCKER_HOST
              value: tcp://localhost:2375
          volumeMounts:
            - name: runner-storage
              mountPath: /runner
        - name: dind
          image: {{ github_runner_dind_image }}
          args: ['--host=tcp://0.0.0.0:2375', '--host=unix:///var/run/docker.sock']
          securityContext:
            privileged: true
          env:
            - name: DOCKER_TLS_CERTDIR
              value: ''
      volumes:
        - name: runner-storage
          emptyDir: {}
{% endfor %}
