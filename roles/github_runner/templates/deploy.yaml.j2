apiVersion: v1
kind: Namespace
metadata:
  name: {{ github_runner_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: github-runner-access-token
  namespace: {{ github_runner_namespace }}
type: Opaque
stringData:
  ACCESS_TOKEN: "{{ github_runner_access_token }}"
{% for runner in github_runners %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ runner.name }}
  namespace: {{ github_runner_namespace }}
  labels:
    app: {{ runner.name }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ runner.name }}
  template:
    metadata:
      labels:
        app: {{ runner.name }}
    spec:
      containers:
        - name: runner
          image: {{ github_runner_image }}
          env:
            - name: RUNNER_NAME
              value: "{{ runner.name }}"
{% if runner.scope == 'org' %}
            - name: RUNNER_SCOPE
              value: org
            - name: ORG_NAME
              value: "{{ runner.target }}"
{% else %}
            - name: RUNNER_SCOPE
              value: repo
            - name: REPO_URL
              value: "https://github.com/{{ runner.target }}"
{% endif %}
            - name: ACCESS_TOKEN
              valueFrom:
                secretKeyRef:
                  name: github-runner-access-token
                  key: ACCESS_TOKEN
            - name: DOCKER_HOST
              value: tcp://localhost:2375
          volumeMounts:
            - name: runner-storage
              mountPath: /runner
        - name: dind
          image: {{ github_runner_dind_image }}
          args: ['--host=tcp://0.0.0.0:2375', '--host=unix:///var/run/docker.sock']
          securityContext:
            privileged: true
          env:
            - name: DOCKER_TLS_CERTDIR
              value: ''
      volumes:
        - name: runner-storage
          emptyDir: {}
{% endfor %}
